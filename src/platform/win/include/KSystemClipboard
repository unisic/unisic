#pragma once
// Windows build only: stands in for KF6GuiAddons' <KSystemClipboard>, which
// MSYS2 does not package. Its point on Linux is reading and offering the
// clipboard without focus (data-control); Windows needs no focus for either,
// so forwarding to QClipboard is the whole implementation.
#include <QClipboard>
#include <QGuiApplication>
#include <QMimeData>

class KSystemClipboard
{
public:
    static KSystemClipboard *instance()
    {
        static KSystemClipboard self;
        return &self;
    }

    // Ownership of `mime` passes to the clipboard, as with KSystemClipboard.
    void setMimeData(QMimeData *mime, QClipboard::Mode mode)
    {
        QGuiApplication::clipboard()->setMimeData(mime, mode);
    }

    // Owned by the clipboard, valid until the clipboard changes.
    const QMimeData *mimeData(QClipboard::Mode mode) const
    {
        return QGuiApplication::clipboard()->mimeData(mode);
    }
};
